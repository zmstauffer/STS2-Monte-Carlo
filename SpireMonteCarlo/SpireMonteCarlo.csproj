<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <AssemblyName>SpireMonteCarlo</AssemblyName>
    <RootNamespace>SpireMonteCarlo</RootNamespace>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <GameDir>C:\Program Files (x86)\Steam\steamapps\common\Slay the Spire 2</GameDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- Harmony — copy 0Harmony.dll from data_sts2_windows_x86_64/ -->
    <Reference Include="0Harmony">
      <HintPath>$(GameDir)\data_sts2_windows_x86_64\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- Godot C# runtime — copy from data_sts2_windows_x86_64/ -->
    <Reference Include="GodotSharp">
      <HintPath>$(GameDir)\data_sts2_windows_x86_64\GodotSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- Game assembly — copy sts2.dll from data_sts2_windows_x86_64/ -->
    <Reference Include="sts2">
      <HintPath>$(GameDir)\data_sts2_windows_x86_64\sts2.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SpireMonteCarlo.Contracts\SpireMonteCarlo.Contracts.csproj" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.0" />
  </ItemGroup>

  <!-- Data\ ships inside mods\SpireMonteCarlo\ (no .json allowed there); AppData\ is staged in the build output
       and deployed to %APPDATA%\SpireMonteCarlo\ by the deploy script. -->
  <ItemGroup>
    <None Include="Data\**\*" CopyToOutputDirectory="PreserveNewest" />
    <None Include="AppData\**\*" CopyToOutputDirectory="PreserveNewest" />
    <None Include="SpireMonteCarlo.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
